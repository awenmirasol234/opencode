{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "engineering-lead",
  "agents": {
    "plan": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "build": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
