{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "engineering-lead",
  "subagent_depth": 1,
  "permissions": [
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "agents": {
    "plan": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "build": {
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
